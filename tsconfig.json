{
  "extends": "astro/tsconfigs/base",
  "include": [
    "src/**/*",
    ".astro/types.d.ts",
    "tests/**/*",
    "backend/**/*.test.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "archivo",
    "node_modules",
    ".e2e"
  ],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}

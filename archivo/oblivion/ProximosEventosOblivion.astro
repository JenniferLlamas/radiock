---
import Evento from "@components/Evento.astro";
---

<section class="py-12 px-6" id="eventos">
  <div class="bg-white sm:py-8">
    <div class="container mx-auto">
      <h2 class="text-3xl font-bold mb-8">Próximos Eventos</h2>
      <ul class="grid grid-cols-1 xl:grid-cols-1 gap-x-6 items-start">
        <Evento
          title="Radiock"
          description="Ven, toma unos tragos y escucha a estas bandas de Rock!! No te pierdas la oportunidad de disfrutar de buena música y ambiente. ¡Ven con tus amigos, toma unos tragos y vive la energía del rock en vivo! "
          date="10 de Agosto del 2024"
          place="La Republica de Hops cervecería Pasaje Revolución"
          url="https://www.facebook.com/events/829154165945581"
          image="/radiock/logo.jpeg"
        />
      </ul>
    </div>
  </div>
</section>

---
import '../styles/eventos-organizados.css';
import { sitio } from '@/compartido';
import { agendaEventos } from '../services/agenda';
import TarjetaEventoProximo from './TarjetaEventoProximo.astro';
import TarjetaEventoAnterior from './TarjetaEventoAnterior.astro';
const proximos = agendaEventos.proximos();
const anteriores = agendaEventos.anteriores();
// El archivo incluye también los próximos, ocultos: si su fecha pasa, useAgendaEnVivo los muestra.
const archivo = [...anteriores.map((evento) => ({ evento, oculto: false })), ...proximos.map((evento) => ({ evento, oculto: true }))];
---
<section class="events-section" id="eventos" aria-labelledby="events-title" data-agenda>
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">05 / NOS VEMOS FRENTE AL ESCENARIO</p>
      <h2 id="events-title">Próximos eventos.</h2>
    </div>
    {archivo.length > 0 && <a class="text-link" href="#eventos-anteriores" data-agenda-recorrido hidden={anteriores.length === 0}>Nuestro recorrido ↓</a>}
  </div>
  <div class="event-grid" data-agenda-proximos data-cantidad={proximos.length} hidden={proximos.length === 0}>{proximos.map((evento) => <TarjetaEventoProximo evento={evento} />)}</div>
  <div class="empty-event" data-reveal data-agenda-vacio hidden={proximos.length > 0}>
    <div class="empty-date" aria-hidden="true">PRÓX.<span>ENCUENTRO</span>
    </div>
    <div>
      <span class="status">EL SIGUIENTE ESCENARIO ESTÁ POR ANUNCIARSE</span>
      <h3>La próxima fecha comienza a tomar forma.</h3>
      <p>Aún no hay eventos anunciados. Sigue a Radiock para conocer el próximo cartel y descubrir quiénes se subirán al escenario.</p>
    </div>
    <a class="button-outline" href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer">Seguir en Instagram ↗</a>
  </div>
  {archivo.length > 0 && <div id="eventos-anteriores" data-agenda-anteriores hidden={anteriores.length === 0}>
    <h3 class="past-heading">Eventos anteriores</h3>{archivo.map(({ evento, oculto }) => <TarjetaEventoAnterior evento={evento} oculto={oculto} />)}</div>}
</section>
<script>
  import { useAgendaEnVivo } from '../hooks/useAgendaEnVivo';
  useAgendaEnVivo(document.querySelector<HTMLElement>('[data-agenda]'));
</script>

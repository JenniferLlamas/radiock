---
import '../styles/eventos-organizados.css';
import { sitio } from '@/compartido';
import { agendaEventos } from '../services/agenda';
import TarjetaEventoProximo from './TarjetaEventoProximo.astro';
import TarjetaEventoAnterior from './TarjetaEventoAnterior.astro';
const proximos = agendaEventos.proximos();
const anteriores = agendaEventos.anteriores();
---
<section class="events-section" id="eventos" aria-labelledby="events-title">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">05 / NOS VEMOS FRENTE AL ESCENARIO</p>
      <h2 id="events-title">Próximos eventos.</h2>
    </div>
    {anteriores.length > 0 && <a class="text-link" href="#eventos-anteriores">Nuestro recorrido ↓</a>}
  </div>
  {proximos.length ? <div class="event-grid">{proximos.map((evento) => <TarjetaEventoProximo evento={evento} />)}</div> :
  <div class="empty-event" data-reveal>
    <div class="empty-date" aria-hidden="true">PRÓX.<span>ENCUENTRO</span>
    </div>
    <div>
      <span class="status">EL SIGUIENTE ESCENARIO ESTÁ POR ANUNCIARSE</span>
      <h3>La próxima fecha comienza a tomar forma.</h3>
      <p>Aún no hay eventos anunciados. Sigue a Radiock para conocer el próximo cartel y descubrir quiénes se subirán al escenario.</p>
    </div>
    <a class="button-outline" href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer">Seguir en Instagram ↗</a>
  </div>
  }
  {anteriores.length > 0 && <div id="eventos-anteriores">
    <h3 class="past-heading">Eventos anteriores</h3>{anteriores.map((evento) => <TarjetaEventoAnterior evento={evento} />)}</div>}
</section>

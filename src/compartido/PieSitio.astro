---
import { sitio } from './configuracion';
---
<footer class="site-footer">
  <div class="shell footer-top">
    <div>
      <a class="brand" href="/#inicio" aria-label="Radiock — inicio">
        <img src="/marca/radiock.webp" width="54" height="54" alt="Logo de Radiock" />
        <span>RADIOCK<span class="brand-dot">.</span>
        </span>
      </a>
      <p>Música local. Escenarios reales.<br />Un proyecto independiente desde Tijuana.</p>
    </div>
    <div>
      <span class="eyebrow">SIGAMOS CONECTADOS</span>
      <ul class="social-links">{Object.entries(sitio.redes).filter(([, url]) => Boolean(url)).map(([name, url]) => <li>
          <a href={url} target="_blank" rel="noopener noreferrer" aria-label={name + ' (abre en otra pestaña)'}>{name === 'youtube' ? 'YouTube' : name === 'tiktok' ? 'TikTok' : name.charAt(0).toUpperCase() + name.slice(1)} ↗</a>
        </li>)}</ul>
    </div>
    <div>
      <span class="eyebrow">HABLEMOS</span>
      <a class="text-link" href={sitio.correo ? 'mailto:' + sitio.correo : '/#contacto'}>{sitio.correo || 'Construyamos algo juntos'} ↗</a>
      <p>Tijuana, Baja California, México.</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Radiock</span>
    <span>Hecho desde la escena. Para la escena.</span>
    <a href="/#inicio">Volver arriba ↑</a>
  </div>
</footer>

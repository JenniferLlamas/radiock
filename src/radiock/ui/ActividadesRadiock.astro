---
import '../styles/actividades.css';
import { actividades } from '../data/contenido';
import { numeroOrden } from '../helpers/numeroOrden';
---
<section class="activities" aria-labelledby="activities-title">
  <div data-reveal>
    <p class="eyebrow">04 / QUÉ HACEMOS</p>
    <h2 id="activities-title">De la idea<br />al escenario.</h2>
    <p>Hacemos que las cosas sucedan,<br />con lo que tenemos y entre todos.</p>
  </div>
  <div class="activity-list">{actividades.map(({ titulo, texto }, index) => <article data-reveal>
      <span class="eyebrow">{numeroOrden(index)}</span>
      <div>
        <h3>{titulo}</h3>
        <p>{texto}</p>
      </div>
      <span aria-hidden="true" class="accent">↗</span>
    </article>)}</div>
</section>

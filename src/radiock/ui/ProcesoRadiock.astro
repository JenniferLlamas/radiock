---
import '../styles/proceso.css';
import { proceso } from '../data/contenido';
import { numeroOrden } from '../helpers/numeroOrden';
---
<section class="process-section" aria-labelledby="process-title">
  <div class="shell">
    <p class="eyebrow">05 / ASÍ SUCEDE</p>
    <h2 id="process-title">Cómo funciona Radiock.</h2>
    <ol class="process">{proceso.map(({ titulo, texto }, index) => <li data-reveal>
        <span class="step-number">{numeroOrden(index)}</span>
        <h3>{titulo}</h3>
        <p>{texto}</p>
      </li>)}</ol>
  </div>
</section>

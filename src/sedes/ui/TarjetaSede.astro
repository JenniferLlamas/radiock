---
// Tarjeta de sede: solo el logo. El nombre, la ubicación y los eventos van en el texto alternativo.
import '../styles/tarjeta-sede.css';
import { agendaEventos } from '@/eventos';
import type { Sede } from '../domain/Sede';
interface Props {
  sede: Sede;
}
const { sede } = Astro.props;
const ediciones = sede.eventos
  .map((id) => agendaEventos.porId(id)?.titulo)
  .filter((titulo) => titulo !== undefined);
const listaEdiciones = new Intl.ListFormat('es', { type: 'conjunction' }).format(ediciones);
const alt = `Logo de ${sede.nombre} (${sede.ubicacion}), sede de ${listaEdiciones}`;
---
<article class="venue-card" data-reveal>
  <img src={sede.logo} alt={alt} width="600" height="360" loading="lazy" />
</article>

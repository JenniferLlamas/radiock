---
import type { Banda } from './bandas';
interface Props { banda: Banda }
const { banda } = Astro.props;
---
<article class="artist" data-reveal>
  <div class="artist-image">
    <img src={banda.logo} alt={'Logo de ' + banda.nombre} width="320" height="190" loading="lazy" />
  </div>
  <div class="artist-copy">
    <h3>{banda.nombre}</h3>
    {(banda.ciudad || banda.genero) && <p class="artist-meta">{[banda.ciudad, banda.genero].filter(Boolean).join(' / ')}</p>}
    {banda.redes.length > 0 && <div class="artist-links">{banda.redes.map((red) => <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre + ' de ' + banda.nombre + ' (abre en otra pestaña)'}>{red.nombre} ↗</a>)}</div>}
  </div>
</article>

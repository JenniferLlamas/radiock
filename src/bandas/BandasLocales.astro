---
import TarjetaBanda from './TarjetaBanda.astro';
import { bandas } from './bandas';
---
<section class="section artists-section" id="bandas" aria-labelledby="artists-title">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">06 / TALENTO CON IDENTIDAD</p>
        <h2 id="artists-title">Bandas que han compartido<br />escenario con Radiock.</h2>
      </div>
      <p>Distintas voces. Una misma escena.<br />Conoce los proyectos del cartel de nuestro primer Radiock Fest.</p>
    </div>
    <div class="band-carousel" role="region" aria-roledescription="carrusel" aria-label="Bandas participantes">
      <div class="artists" id="band-carousel-track" tabindex="0" aria-label="Tarjetas de bandas. Usa las flechas para recorrerlas.">
        {bandas.map((banda) => <TarjetaBanda banda={banda} />)}
      </div>
      <div class="carousel-controls" hidden>
        <p class="carousel-status" aria-live="polite" aria-atomic="true"></p>
        <div class="carousel-buttons">
          <button type="button" class="carousel-arrow" data-direction="-1" aria-label="Ver bandas anteriores" aria-controls="band-carousel-track">←</button>
          <button type="button" class="carousel-arrow" data-direction="1" aria-label="Ver bandas siguientes" aria-controls="band-carousel-track">→</button>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const track = document.querySelector<HTMLElement>('#band-carousel-track');
  const controls = document.querySelector<HTMLElement>('.carousel-controls');
  if (track && controls) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.artist'));
    const previous = controls.querySelector<HTMLButtonElement>('[data-direction="-1"]');
    const next = controls.querySelector<HTMLButtonElement>('[data-direction="1"]');
    const status = controls.querySelector<HTMLElement>('.carousel-status');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      if (previous) previous.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= maxScroll - 2;
      const bounds = track.getBoundingClientRect();
      const visible = cards.map((card, index) => ({ bounds: card.getBoundingClientRect(), index }))
        .filter((card) => card.bounds.left >= bounds.left - 2 && card.bounds.right <= bounds.right + 2);
      if (status && visible.length) {
        const first = visible[0].index + 1;
        const last = visible[visible.length - 1].index + 1;
        const text = first === last ? `Banda ${first} de ${cards.length}` : `Bandas ${first}–${last} de ${cards.length}`;
        if (status.textContent !== text) status.textContent = text;
      }
    };
    const move = (direction: number) => {
      const step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
      track.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
    let timer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(timer);
      timer = setTimeout(update, 120);
    }, { passive: true });
    new ResizeObserver(update).observe(track);
    controls.hidden = false;
    update();
  }
</script>

---
import '../styles/presentacion.css';
import { agendaEventos, BoletoProximoEvento } from '@/eventos';
// Si hay un evento próximo, su boleto (con contador) ocupa el lugar del boleto "Acceso a la escena".
const proximo = agendaEventos.proximos()[0];
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-photo">
    <img src="/comunidad/bluesfire-en-vivo.webp" alt="Bluesfire tocando en un escenario iluminado de violeta" width="1440" height="1080" fetchpriority="high" />
    <span class="photo-credit">ARCHIVO DE LA ESCENA / BLUESFIRE</span>
  </div>
  <div class="hero-content">
    <p class="eyebrow">
      <span class="live-dot">
      </span> TIJUANA, B.C. · MÚSICA INDEPENDIENTE</p>
    <h1 id="hero-title">La música<br />original también<br />merece un<br />
      <span>escenario.</span>
    </h1>
    <p class="hero-lead">Radiock crea espacios para bandas locales que buscan llevar su música más allá de su ciudad.</p>
    <p class="hero-description">Organizamos eventos independientes donde bandas, espacios y público se encuentran para impulsar la escena musical.</p>
    <div class="actions">
      <a class="button-primary" href="#registro-banda">Quiero tocar con Radiock <span aria-hidden="true">↗</span>
      </a>
      <a class="button-outline" href="#radiock">Conoce Radiock <span aria-hidden="true">↓</span>
      </a>
    </div>
    <a class="hero-collab" href="#registro-local">Tengo un espacio / Quiero colaborar <span aria-hidden="true">↗</span>
    </a>
  </div>
  {proximo && <BoletoProximoEvento evento={proximo} class="hero-event-ticket" />}
  <div class="hero-ticket" data-sin-aviso hidden={proximo !== undefined}>
    <span class="eyebrow">ACCESO A LA ESCENA</span>
    <strong>100%<br />ORIGINAL</strong>
    <span>DESDE LA RAÍZ.</span>
  </div>
  
</section>
<div class="statement-strip" aria-hidden="true">
  <span>MÚSICA ORIGINAL</span>
  <b>✳</b>
  <span>ESCENARIOS REALES</span>
  <b>✳</b>
  <span>TALENTO LOCAL</span>
  <b>✳</b>
  <span>COMUNIDAD</span>
</div>

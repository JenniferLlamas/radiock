---
// Una sección del material de la banda (fotos, logos o canciones): zona para arrastrar,
// vistas previas y el <input type="file"> real, que sigue siendo el que envía el formulario.
// Sin JavaScript (o en navegadores antiguos) se ve el selector nativo.
import '../styles/material-banda.css';
import type { ReglaArchivos } from '../domain/ReglaArchivos';
import { valorAccept } from '../helpers/archivos';
interface Props { regla: ReglaArchivos }
const { regla } = Astro.props;
const idTitulo = `titulo-${regla.nombre}`;
const idAyuda = `ayuda-${regla.nombre}`;
---
<fieldset class={`file-section file-section--${regla.vista}`} data-selector-archivos>
  <legend id={idTitulo}>{regla.etiqueta}{regla.obligatorio && ' *'} <span class="file-limit" data-contador>máx. {regla.maximo}</span></legend>
  <p class="field-hint" id={idAyuda}>{regla.ayuda}</p>
  <label class="dropzone" data-zona>
    <input
      class="dropzone-input"
      type="file"
      name={regla.nombre}
      accept={valorAccept(regla)}
      multiple={regla.maximo > 1}
      required={regla.obligatorio}
      aria-labelledby={idTitulo}
      aria-describedby={idAyuda}
    />
    <span class="dropzone-icon" aria-hidden="true">
      {regla.vista === 'audio'
        ? <svg viewBox="0 0 24 24" width="26" height="26"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
        : <svg viewBox="0 0 24 24" width="26" height="26"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>}
    </span>
    <span class="dropzone-text" aria-hidden="true">
      <strong>{regla.textoZona}</strong>
      <span>o <u>elige desde tu dispositivo</u></span>
    </span>
    <span class="dropzone-full" aria-hidden="true">Llegaste al máximo. Quita uno para cambiarlo.</span>
  </label>
  <p class="file-message" data-mensaje role="status"></p>
  <ul class={`file-previews file-previews--${regla.vista}`} data-lista aria-label={`${regla.etiqueta} elegidos`}></ul>
</fieldset>

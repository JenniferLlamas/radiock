---
// Registro de bandas con envío: datos, fotos, logos y canciones (backend/registro-bandas).
import { sitio } from '@/compartido';
import { MAX_BYTES_TOTAL } from '../constants/archivos';
import { megas } from '../helpers/archivos';
import FormularioConEnvio from './FormularioConEnvio.astro';
interface Props { url: string }
const { url } = Astro.props;
---
<FormularioConEnvio
  tipo="banda"
  url={url}
  titulo="Cuéntanos de tu banda."
  intro="Completa tus datos y comparte tus fotos, logos y canciones."
  leyenda="Registro de la banda"
  material="MATERIAL DE LA BANDA"
  boton="Enviar registro"
  nota={`En total, los archivos pueden pesar hasta ${megas(MAX_BYTES_TOTAL)}.`}
  otro="Registrar otra banda"
>
  <p class="lead" tabindex="-1">¡Listo! Recibimos el registro de <strong data-registro-nombre></strong>.</p>
  <p>Revisaremos tu música y te escribiremos al contacto que nos dejaste. Mientras tanto, síguenos en <a class="text-link" href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></p>
</FormularioConEnvio>

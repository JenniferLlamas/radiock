---
// Registro de locales con envío: nombre, responsable, ubicación y contacto (backend/registro-locales).
import { sitio } from '@/compartido';
import FormularioConEnvio from './FormularioConEnvio.astro';
interface Props { url: string }
const { url } = Astro.props;
---
<FormularioConEnvio
  tipo="local"
  url={url}
  titulo="Cuéntanos de tu espacio."
  intro="Déjanos los datos de tu local y te contactamos para organizar juntos el próximo evento."
  leyenda="Registro del local"
  boton="Sumar mi espacio"
  nota="Tus datos se guardan en el Drive de Radiock y solo los usa el equipo para contactarte."
  otro="Registrar otro local"
>
  <p class="lead" tabindex="-1">¡Gracias! Recibimos los datos de <strong data-registro-nombre></strong>.</p>
  <p>Te escribiremos pronto para platicar del espacio. Mientras tanto, síguenos en <a class="text-link" href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></p>
</FormularioConEnvio>

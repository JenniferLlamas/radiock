---
import RedesSocialesRadiock from './RedesSocialesRadiock.astro';
import { sitio } from '../compartido/configuracion';
---
<section class="section shell" id="contacto" aria-labelledby="contact-title">
  <div class="contact-grid">
    <div data-reveal>
      <p class="eyebrow">09 / CONSTRUYAMOS LO QUE SIGUE</p>
      <h2 id="contact-title">Todo empieza<br />con una<br />
        <span class="accent">conversación.</span>
      </h2>
      <p>¿Tienes un espacio, una idea o ganas de apoyar? Escríbenos por nuestras redes. Queremos conocerte y encontrar una forma de sumar.</p>
      <RedesSocialesRadiock />{sitio.correo && <a class="text-link" href={'mailto:' + sitio.correo}>{sitio.correo}</a>}</div>
    <div class="registration" id="registro-banda">
      <h3>Cuéntanos de tu banda.</h3>
      <p>Prepara tu presentación y compártela con Radiock por Instagram o Facebook. Los campos marcados con * son obligatorios.</p>
      <form id="form-banda" aria-describedby="form-note">
        <fieldset id="campos-banda" disabled>
          <legend class="sr-only">Presentación de la banda</legend>
          <div class="form-grid">
            <label class="field">Nombre de la banda *<input name="banda" autocomplete="organization" required maxlength="120" placeholder="Así nos llamamos" />
            </label>
            <label class="field">Ciudad *<input name="ciudad" autocomplete="address-level2" required maxlength="120" placeholder="De dónde venimos" />
            </label>
            <label class="field">Género *<input name="genero" required maxlength="120" placeholder="A qué sonamos" />
            </label>
            <label class="field">Instagram<input name="instagram" type="url" placeholder="https://www.instagram.com/…" maxlength="300" />
            </label>
            <label class="field">YouTube<input name="youtube" type="url" placeholder="https://www.youtube.com/…" maxlength="300" />
            </label>
            <label class="field">Contacto *<input name="contacto" required maxlength="200" placeholder="Correo, teléfono o perfil donde encontrarte" />
            </label>
          </div>
          <button type="submit" class="button button-primary">Preparar mi presentación ↗</button>
        </fieldset>
        <p class="form-note" id="form-note">Tus datos no se envían ni se guardan en este sitio. Podrás revisar y copiar tu mensaje antes de compartirlo.</p>
      </form>
      <noscript>
        <p class="form-note">Para preparar el mensaje activa JavaScript, o escríbenos directamente por nuestras redes.</p>
      </noscript>
      <div class="message-preview" id="message-preview" hidden>
        <p id="preview-heading" tabindex="-1">Tu presentación está lista. Cópiala y envíala a Radiock por mensaje directo.</p>
        <label class="field" for="message-text">Tu mensaje</label>
        <textarea id="message-text" readonly aria-label="Presentación de tu banda lista para copiar">
        </textarea>
        <div class="actions">
          <button type="button" class="button button-primary" id="copy-message">Copiar mensaje</button>
          <a class="button button-outline" href={sitio.redes.instagram} target="_blank" rel="noopener noreferrer">Abrir Instagram ↗</a>
          <a class="text-link" href={sitio.redes.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        </div>
        <p role="status" id="copy-status" class="form-note">
        </p>
      </div>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#form-banda');
  const preview = document.querySelector<HTMLElement>('#message-preview');
  const message = document.querySelector<HTMLTextAreaElement>('#message-text');
  const status = document.querySelector<HTMLElement>('#copy-status');
  const fieldsContainer = document.querySelector<HTMLFieldSetElement>('#campos-banda');
  if (fieldsContainer) fieldsContainer.disabled = false;
  form?.querySelectorAll<HTMLInputElement>('input[required]').forEach((input) => {
    input.addEventListener('input', () => input.setCustomValidity(input.value.trim() ? '' : 'Completa este campo.'));
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!preview || !message) return;
    const data = new FormData(form);
    const fields = [['banda', 'Banda'], ['ciudad', 'Ciudad'], ['genero', 'Género'], ['instagram', 'Instagram'], ['youtube', 'YouTube'], ['contacto', 'Contacto']];
    const lines = fields.map(([key, label]) => {
      const value = String(data.get(key) || '').trim();
      return value ? label + ': ' + value : '';
    }).filter(Boolean);
    message.value = ['¡Hola, Radiock! Queremos compartir nuestra música original con ustedes.', '', ...lines].join('\n');
    preview.hidden = false;
    if (status) status.textContent = '';
    document.querySelector<HTMLElement>('#preview-heading')?.focus();
  });
  document.querySelector<HTMLButtonElement>('#copy-message')?.addEventListener('click', async () => {
    if (!message || !status) return;
    try {
      await navigator.clipboard.writeText(message.value);
      status.textContent = 'Mensaje copiado. Abre nuestras redes y pégalo en un mensaje directo.';
    } catch {
      message.focus(); message.select();
      status.textContent = 'Seleccionamos el mensaje. Usa Copiar en tu dispositivo y pégalo en nuestras redes.';
    }
  });
  // Avoid showing a stale presentation after the visitor edits their details.
  form?.addEventListener('input', () => { if (preview) preview.hidden = true; });
</script>
